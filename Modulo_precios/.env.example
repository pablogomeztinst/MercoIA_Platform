# =========================================================
# MercoIA — variables de entorno
# Copia este archivo a ".env" y completa los valores.
#   cp .env.example .env
# =========================================================

# ---------- WhatsApp Cloud API (Meta) ----------
# Panel: https://developers.facebook.com -> tu App -> WhatsApp -> API Setup
# Token temporal (24h) o permanente (System User token, recomendado para producción)
WHATSAPP_TOKEN=coloca_aqui_tu_access_token

# "Phone number ID" que aparece en el panel de WhatsApp > API Setup (NO es el número telefónico)
WHATSAPP_PHONE_NUMBER_ID=coloca_aqui_tu_phone_number_id

# Token inventado por ti (cualquier cadena secreta). Debes escribir el MISMO valor
# en Meta al configurar el webhook ("Verify token").
WHATSAPP_VERIFY_TOKEN=coloca_un_secreto_para_verificar_el_webhook

# "App secret" de tu App de Meta (Configuración básica de la App).
# Se usa para validar la firma X-Hub-Signature-256 de cada webhook recibido.
# Déjalo vacío solo mientras haces pruebas locales; en producción es obligatorio.
WHATSAPP_APP_SECRET=

# Versión de la Graph API a usar
WHATSAPP_API_VERSION=v21.0

# ---------- OpenAI (normalizador de nombres de producto) ----------
OPENAI_API_KEY=coloca_aqui_tu_openai_api_key
# Mismo modelo que usaba el flujo de n8n original: el más barato/rápido de OpenAI,
# más que suficiente para elegir un nombre de producto entre una lista corta.
OPENAI_MODEL=gpt-4.1-nano-2025-04-14

# ---------- Base de datos / Cache ----------
# Estos dos ya vienen resueltos por docker-compose.yml (apuntan a los contenedores
# "postgres" y "redis"). Solo necesitas tocarlos si corres la app FUERA de Docker.
POSTGRES_USER=mercoia
POSTGRES_PASSWORD=mercoia
POSTGRES_DB=mercoia
# DATABASE_URL=postgresql+asyncpg://mercoia:mercoia@localhost:5432/mercoia
# REDIS_URL=redis://localhost:6379/0

# ---------- Aplicación ----------
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=America/Bogota

# Días hacia atrás que se buscan al pedir la base SIPSA más reciente
SIPSA_MAX_DIAS_ATRAS=20

# Fuente principal de precios SIPSA: "pentaho" (dashboard oficial del DANE,
# cubre frutas + tubérculos/raíces/plátanos + verduras y hortalizas) o
# "excel" (el .xlsx estático de siempre, solo Bogotá/Bucaramanga). La que NO
# quede elegida aquí se usa automáticamente como respaldo si la principal
# falla para un día puntual (ver app/services/sipsa_fetch.py).
# SIPSA_DATA_SOURCE=pentaho

# Pequeña pausa (segundos) antes de enviar cada mensaje, para que la conversación
# se sienta más natural (equivalente al "delay" de los nodos Send Text en n8n)
SEND_MESSAGE_DELAY_SECONDS=1.0
